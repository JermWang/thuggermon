# Absolute base URL, used to build the og:/twitter: image and url tags.
# Committed on purpose — no secrets here, and the share card is broken without it.
#
# On Vercel this is overridden automatically by the build command in
# vercel.json, which reads the project's real production domain. This value is
# the fallback for local builds and previews.
VITE_SITE_URL=https://thuggermon.vercel.app
